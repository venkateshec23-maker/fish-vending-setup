# Smart Fish Vending Machine - Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production-12345
FLASK_ENV=development
PORT=5050

# Database
DATABASE_URL=sqlite:///fish_vending.db

# MQTT / Adafruit IO Configuration
MQTT_BROKER=io.adafruit.com
MQTT_PORT=1883
MQTT_USERNAME=your-adafruit-username
MQTT_PASSWORD=your-adafruit-io-key

# CORS (optional)
CORS_ORIGIN=*

# ESP32 Hardware Controller Configuration
ESP32_IP=192.168.1.100
ESP32_PORT=80
ESP32_TIMEOUT=30
ESP32_RETRIES=3
ESP32_RETRY_DELAY=5
